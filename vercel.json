{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/agentic",
      "destination": "/ai-security/owasp-agentic-top10",
      "permanent": false
    },
    {
      "source": "/llm",
      "destination": "/ai-security/owasp-llm-top10",
      "permanent": false
    },
    {
      "source": "/redteam",
      "destination": "/ai-security/red-teaming",
      "permanent": false
    },
    {
      "source": "/security",
      "destination": "/ai-security",
      "permanent": false
    },
    {
      "source": "/genai",
      "destination": "/genai-course",
      "permanent": true
    },
    {
      "source": "/genai/:slug",
      "destination": "/genai-course/:slug",
      "permanent": true
    },
    {
      "source": "/aws",
      "destination": "/aws-saa",
      "permanent": false
    }
  ]
}